{
  "expo": {
    "name": "Empório Coisas de Minas",
    "slug": "emporio-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.emporiocoisasdeminas.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#52170c",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-foreground.png",
          "resizeMode": "contain",
          "backgroundColor": "#52170c"
        }
      ]
    ]
  }
}
